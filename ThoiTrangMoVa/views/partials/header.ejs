<header>
    <div class="header-container">
        <div class="logo">
            <a href="/" class="logo"><img src="/images/logo.png" alt="Logo Mova"></a>
        </div>
        <nav class="main-nav">
            <ul>
                <li><a href="/">Trang chủ</a></li>
                <li><a href="/shop">Cửa hàng</a></li>
                <li><a href="/about">Về chúng tôi</a></li>
                <li><a href="/contact">Liên hệ</a></li>
                <li><a href="/blog">Bài viết</a></li>
            </ul>
        </nav>
        <div class="nav-icons">
            <div class="search-wrapper">
                
                <form action="/" method="GET" class="search-form">
                    <input type="text" name="search" placeholder="Tìm kiếm..."  value="<%= searchQuery %>">
                    <i class="fas fa-search"></i>
                    <button type="submit" class="search-button">Tìm</button>         
                </form>
            </div>
            <i class="far fa-user"></i>
            <i class="far fa-heart"></i>
            <a href="/gio-hang" class="cart-icon-link"> 
                <i class="fa-solid fa-cart-plus"></i>
                <% if (cartItemCount> 0) { %>
                    <span class="cart-item-count">
                        <%= cartItemCount %>
                    </span>
                    <% } %></a>
            </div>
    </div>
</header>